# Environment and Service Config
ENVIRONMENT=development
SERVICE_NAME=supplier-browser-service
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DEBUG=false
RUN_LIVE_SUPPLIER_TESTS=false

# Security & API Authentication
# Secret used for hashing client API keys (HMAC / salted SHA-256)
API_KEY_SECRET=change-this-in-production-to-a-secure-random-string-at-least-32-chars
# Default master API key for initial administration/bootstrapping (unhashed in env, checked securely)
BOOTSTRAP_ADMIN_API_KEY=change-this-admin-key-in-production-min-32-chars
# Secret used by Laravel API client via X-Internal-Service-Secret header
INTERNAL_SERVICE_SECRET=change-this-internal-secret-in-production-min-32-chars
# Secret used for QuickBuy payload HMAC-SHA256 signing
QUICK_BUY_SIGNING_SECRET=change-this-quickbuy-secret-in-production-min-32-chars
ENFORCE_API_KEYS=true

# Database (PostgreSQL)
# Uses asyncpg driver: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supplier_browser
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis (Caching, Rate Limiting, Job Queues, Distributed Locks)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# S3-Compatible Diagnostic Storage (MinIO or AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=supplier-diagnostics
S3_REGION=us-east-1
S3_USE_SSL=false
DIAGNOSTIC_MODE_ENABLED=false
DIAGNOSTIC_RETENTION_HOURS=24

# Browser Execution Pool
BROWSER_HEADLESS=true
BROWSER_MAX_GLOBAL_CONCURRENCY=8
BROWSER_MAX_PER_SUPPLIER_CONCURRENCY=3
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_SELECTOR_TIMEOUT_MS=10000
BROWSER_TOTAL_TIMEOUT_MS=45000
BROWSER_RECYCLE_PAGE_LIMIT=100
BROWSER_RECYCLE_MEMORY_MB=1024
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
# Optional Playwright proxy. Supports HTTP(S) and SOCKS proxy server URLs.
# Keep credentials in deployment secrets; never commit real values.
BROWSER_PROXY_SERVER=
BROWSER_PROXY_USERNAME=
BROWSER_PROXY_PASSWORD=
BROWSER_PROXY_BYPASS=localhost,127.0.0.1,postgres,redis

# Cache TTLs (Seconds)
CACHE_SEARCH_TTL_SECONDS=1800
CACHE_PRODUCT_TTL_SECONDS=86400
CACHE_NEGATIVE_TTL_SECONDS=3600
CACHE_STALE_WHILE_REVALIDATE_SECONDS=300

# Rate Limiting (Requests per minute per supplier)
RATE_LIMIT_EBAY_RPM=60
RATE_LIMIT_AMAZON_RPM=30
RATE_LIMIT_DEFAULT_RPM=60
CLIENT_DEFAULT_RPM=120

# Official Supplier API: eBay Browse API
# Obtain from https://developer.ebay.com/
EBAY_API_ENABLED=true
EBAY_APP_ID=your_ebay_app_id
EBAY_CERT_ID=your_ebay_cert_id
EBAY_ENVIRONMENT=PRODUCTION
EBAY_BROWSER_FALLBACK_ENABLED=false
# Sandbox token endpoint: https://api.sandbox.ebay.com/identity/v1/oauth2/token
# Production token endpoint: https://api.ebay.com/identity/v1/oauth2/token

# Official Supplier API: Amazon Product Advertising API (PA-API 5.0)
# Obtain from https://affiliate-program.amazon.com/
AMAZON_API_ENABLED=false
AMAZON_ACCESS_KEY=your_amazon_paapi_access_key
AMAZON_SECRET_KEY=your_amazon_paapi_secret_key
AMAZON_PARTNER_TAG=your_partner_tag-20
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1

# SSRF and Network Security Controls
ALLOWED_CUSTOM_DEV_HOSTS=localhost,127.0.0.1,testserver
ENFORCE_HTTPS_ONLY=true
MAX_REDIRECT_HOPS=5
MAX_URL_LENGTH=2048

# OpenTelemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=supplier-browser-service
METRICS_ENABLED=true
